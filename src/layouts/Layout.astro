---
import '../styles/site.css';
import '../styles/composer.css';
import data from '../data/community.json';
import { github, collectBoards, boardHref, boardName } from '../lib/community.mjs';
const { title = '相机硬件交流社区', description = 'cam-ins：一起研究相机硬件，分享知识、提出问题、发布固件与软件。', activeBoard = '', active = 'feed' } = Astro.props;
const boards = collectBoards(data.discussions);
const sidebarBoards = boards.filter(b => b.depth === 0 || b.name.startsWith('相机固件/')).slice(0, 14);
const apiUrl = import.meta.env.PUBLIC_COMMUNITY_API || '';
const apiOrigin = apiUrl ? new URL(apiUrl).origin : '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e5347" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="cam-ins-api" content={apiOrigin} />
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; connect-src 'self' ${apiOrigin}; object-src 'none'; base-uri 'self'; form-action https://github.com; upgrade-insecure-requests`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} · cam-ins</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到内容</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="cam-ins 首页"><span class="brand-mark" aria-hidden="true">c<span>·</span></span><span>cam-ins<span class="brand-sub">相机硬件社区</span></span></a>
      <nav class="top-nav" aria-label="主导航">
        <a href="/" aria-current={active === 'feed' ? 'page' : undefined}>社区</a>
        <a href="/boards/" aria-current={active === 'boards' ? 'page' : undefined}>板块</a>
        <a href="/guide/" aria-current={active === 'guide' ? 'page' : undefined}>使用指南</a>
      </nav>
      <div class="header-actions"><a class="github-login" href="/publish/" data-account-link>GitHub 登录</a><a class="button small" href="/publish/">＋ 发布文章</a></div>
    </header>
    <div class="shell">
      <aside class="sidebar" aria-label="社区导航">
        <div class="sidebar-group">
          <a class:list={['side-link', { selected: active === 'feed' && !activeBoard }]} href="/"><span aria-hidden="true">▤</span>全部文章</a>
          <a class="side-link" href="/?type=question"><span aria-hidden="true">?</span>问题与解答</a>
          <a class="side-link" href="/?type=release"><span aria-hidden="true">↓</span>固件 / 软件</a>
        </div>
        <div class="sidebar-heading">浏览板块<a href="/boards/" aria-label="查看全部板块">↗</a></div>
        <div class="sidebar-group board-tree">
          {sidebarBoards.map(b => <a class:list={['side-link', { selected: b.name === activeBoard }]} style={`--depth:${Math.min(b.depth, 3)}`} href={boardHref(b.name)} title={b.name}><span class="hash" aria-hidden="true">#</span><span class="board-name">{boardName(b.name)}</span><span class="tiny-count">{b.count}</span></a>)}
          <a class="side-link muted" href="/boards/">所有板块 <span aria-hidden="true">→</span></a>
        </div>
        <div class="sidebar-heading">一起建设</div>
        <div class="sidebar-group"><a class="side-link" href="/guide/#boards"><span aria-hidden="true">＋</span>创建 / 调整板块</a><a class="side-link" href="/feedback/"><span aria-hidden="true">↳</span>建议与反馈</a><a class="side-link" href="/moderation/"><span aria-hidden="true">◇</span>社区公约</a></div>
        <div class="sidebar-note"><span class="status-dot"></span>开放记录，认真交流。<br /><a href="/privacy/">公开内容与隐私</a><span> · </span><a href={github}>站点源码 ↗</a></div>
      </aside>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <footer class="site-footer"><span><b>cam-ins</b> · 关于相机，继续往里看。</span><span><a href="/guide/">使用指南</a><a href={`${github}/discussions`}>GitHub Discussions ↗</a><a href={`${github}/blob/main/docs/FRAMEWORK_RESEARCH.md`}>框架调研</a></span></footer>
  </body>
</html>
<script>
  import { readSession } from '../lib/auth-client.mjs';
  const session=readSession();const account=document.querySelector('[data-account-link]');
  if(session && account)account.textContent=`@${session.user.login}`;
</script>
