---
import Layout from '../layouts/Layout.astro';
import ArticleFeed from '../components/ArticleFeed.astro';
import Icon from '../components/Icon.astro';
import data from '../data/community.json';
import { boardHref, collectBoards } from '../lib/community.mjs';
const boards = collectBoards(data.discussions);
const featured = ['相机固件', '相机固件/索尼', '相机固件/索尼/a7c2', '相机硬件', '软件与工具'];
---
<Layout>
  <header class="page-heading home-heading"><h1>相机硬件社区</h1><span class="heading-count">{data.totalCount} 篇文章</span></header>
  <section class="board-shortcuts" aria-label="板块入口">
    <div class="section-heading"><h2><Icon name="grid" size={16}/>板块</h2><a href="/boards/">全部板块 <Icon name="arrow" size={16}/></a></div>
    <div class="board-shortcut-list">{featured.map(name => <a href={boardHref(name)}><span>#{name.replaceAll('/', ' / ')}</span><small>{boards.find(b=>b.name===name)?.count || 0}</small></a>)}</div>
  </section>
  <div class="content-columns">
    <div class="feed-column"><ArticleFeed discussions={data.discussions}/><p class="snapshot-note">同步于 {new Date(data.generatedAt).toLocaleString('zh-CN', { timeZone: 'Asia/Taipei', hour12: false })} · <a href="https://github.com/bcm-ins/bcm-ins.github.io/discussions">实时讨论</a></p></div>
    <aside class="right-rail" aria-label="社区操作">
      <section class="rail-section"><h2>发布文章</h2><p>使用 GitHub 账号登录，支持 Markdown 和多板块归属。</p><a class="button full" href="/publish/"><Icon name="plus" size={16}/>撰写文章</a></section>
      <section class="rail-section reading-links"><h2>社区管理</h2><a href="/guide/#boards">创建与修改板块 <Icon name="arrow" size={15}/></a><a href="/firmware-guide/">固件 / 软件发布规范 <Icon name="arrow" size={15}/></a><a href="/moderation/">社区公约 <Icon name="arrow" size={15}/></a><a href="/feedback/">问题反馈 <Icon name="arrow" size={15}/></a></section>
    </aside>
  </div>
</Layout>
