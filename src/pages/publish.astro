---
import Layout from '../layouts/Layout.astro';
import { types, collectBoards } from '../lib/community.mjs';
import data from '../data/community.json';
import Icon from '../components/Icon.astro';
const boards=collectBoards(data.discussions);
---
<Layout title="撰写文章">
  <div class="composer-heading"><div><h1 data-editor-title>发布文章</h1></div><a href="/guide/" class="quiet-link">写作指南 ↗</a></div>
  <div class="composer-account"><span data-account-status>可以先写作，发布时使用 GitHub 账号登录。</span><button type="button" class="text-button" data-login>GitHub 登录</button><button type="button" class="text-button" data-logout hidden>退出登录</button></div>
  <form class="composer" data-composer>
    <fieldset class="composer-types"><legend>文章类型</legend>{types.map((t,i)=><label class="composer-type"><input type="radio" name="type" value={t.key} checked={i===0}/><span class={`type-icon ${t.key}`} aria-hidden="true"><Icon name={t.key} size={18}/></span><span>{t.name}</span></label>)}</fieldset>
    <div class="composer-boards"><label for="board-input">板块 <span>可选多个，使用 / 添加子板块</span></label><div class="board-input-row"><span aria-hidden="true">#</span><input id="board-input" list="board-suggestions" placeholder="相机固件/索尼/a7c2" autocomplete="off"/><button type="button" data-add-board>添加</button></div><datalist id="board-suggestions">{boards.map(b=><option value={b.name}/>)}</datalist><div class="selected-boards" data-selected-boards aria-label="已选择的板块"></div><p class="field-help">输入新名称即可创建板块，按 Enter 添加；也可以粘贴多个 #标签。</p></div>
    <label class="sr-only" for="article-title">文章标题</label><input id="article-title" class="composer-title" placeholder="文章标题" maxlength="180" required/>
    <div class="editor-toolbar"><div role="group" aria-label="Markdown 格式"><button type="button" data-format="bold" title="粗体" aria-label="粗体"><Icon name="bold" size={16}/></button><button type="button" data-format="italic" title="斜体" aria-label="斜体"><Icon name="italic" size={16}/></button><button type="button" data-format="heading" title="标题" aria-label="插入标题"><Icon name="heading" size={17}/></button><span class="toolbar-divider"></span><button type="button" data-format="link" title="链接 / 固件下载" aria-label="插入链接"><Icon name="link" size={17}/></button><button type="button" data-format="image" title="图片链接" aria-label="插入图片链接"><Icon name="image" size={17}/></button><button type="button" data-format="code" title="代码块" aria-label="插入代码块"><Icon name="code" size={17}/></button><button type="button" data-format="list" title="列表" aria-label="插入列表"><Icon name="list" size={17}/></button></div><div class="editor-view" role="group" aria-label="编辑视图"><button type="button" data-view="write" aria-pressed="true">撰写</button><button type="button" data-view="split" aria-pressed="false">对照</button><button type="button" data-view="preview" aria-pressed="false">预览</button></div></div>
    <div class="editor-panels" data-view-mode="write"><label class="sr-only" for="article-body">Markdown 正文</label><textarea id="article-body" spellcheck="false" placeholder="Markdown 正文，支持标题、表格、图片、代码和下载链接。" maxlength="60000" required></textarea><div class="prose markdown-preview" data-preview hidden aria-label="Markdown 预览"></div></div>
    <div class="editor-status"><span data-save-status role="status">草稿保存在当前设备的浏览器中</span><span data-word-count>0 字符</span></div>
    <div class="release-fields" data-release-help hidden><strong>发布信息</strong><p>正文中请写明版本、适配机型、验证状态、下载链接、SHA-256、许可及恢复方法。<button type="button" data-release-template>插入发布模板</button></p></div>
    <div class="composer-actions"><div><button type="button" class="text-button" data-export>导出 Markdown</button><button type="button" class="text-button" data-import>导入 Markdown</button><input type="file" accept=".md,.markdown,text/markdown,text/plain" data-import-file hidden/></div><button class="button" type="submit" data-publish>发布文章</button></div>
  </form>
  <p class="composer-message" role="status" data-message></p>
  <div class="publish-success" data-success hidden><h2>文章已发布。</h2><p>可以立即在本站阅读和回复。首页与板块列表将在自动同步后更新。</p><div><a class="button" data-success-local>查看文章</a><a class="control" href="/u/">我的个人主页</a><a class="text-link" href="/publish/">再写一篇</a></div></div>
  <p class="snapshot-note">正文以 Markdown 保存到社区 Discussions。图片和固件可嵌入下载链接；草稿不上传，发布后内容公开。<a href="/privacy/">隐私说明</a></p>
</Layout>
<script src="../scripts/composer.mjs"></script>
